From 028c4af10e0ab673f4cefa4411fe4a2f327c210e Mon Sep 17 00:00:00 2001
From: "chang.liu" <chang.liu@amd.com>
Date: Mon, 24 Aug 2026 18:51:50 +0800
Subject: [PATCH 2/2] hipBLASLt: cap TensileLogic parallelism on Windows

ParallelMap2 ignored the -j argument and joblib loky opened too many worker
processes, exhausting Windows handles (WinError 1450). Respect procs and
default to four workers on Windows.

The CMakeLists.txt --jobs=4/--cxx-compiler hunk this patch originally also
carried is dropped on this base: hipblaslt_create_device_library() (in
cmake/HipBLASLtCodegen.cmake) already always passes --cxx-compiler
unconditionally, and falls through to this same Python-side default when
the caller does not pass an explicit --jobs, so that hunk is redundant
here.

Co-authored-by: Cursor <cursoragent@cursor.com>
---
 .../tensilelite/Tensile/Common/Parallel.py    | 19 +++++++++++++------
 .../Tensile/TensileLogic/ParseArguments.py    |  3 ++-
 2 files changed, 15 insertions(+), 7 deletions(-)

diff --git a/projects/hipblaslt/tensilelite/Tensile/Common/Parallel.py b/projects/hipblaslt/tensilelite/Tensile/Common/Parallel.py
index 1a2bf9e119..0f9fa68090 100644
--- a/projects/hipblaslt/tensilelite/Tensile/Common/Parallel.py
+++ b/projects/hipblaslt/tensilelite/Tensile/Common/Parallel.py
@@ -54,8 +54,11 @@ def CPUThreadCount(enable=True):
             cpu_count = min(os.cpu_count(), 61)
         else:
             cpu_count = len(os.sched_getaffinity(0))
-        cpuThreads = globalParameters["CpuThreads"]
+        cpuThreads = globalParameters.get("CpuThreads", -1)
         if cpuThreads == -1:
+            if os.name == "nt":
+                # loky subprocess pool exhausts Windows handles above ~4 workers.
+                return min(cpu_count, 4)
             return cpu_count
 
         return min(cpu_count, cpuThreads)
@@ -213,9 +216,11 @@ def ParallelMap2(
 
     from .GlobalParameters import globalParameters
 
-    threadCount = procs if procs else CPUThreadCount(enable)
-
-    threadCount = CPUThreadCount(enable)
+    max_threads = CPUThreadCount(enable)
+    if procs is not None:
+        threadCount = min(int(procs), max_threads)
+    else:
+        threadCount = max_threads
 
     if threadCount <= 1 and globalParameters["ShowProgressBar"]:
         # Provide a progress bar for single-threaded operation.
@@ -236,12 +241,14 @@ def ParallelMap2(
     pcall = pcallWithGlobalParamsMultiArg if multiArg else pcallWithGlobalParamsSingleArg
     pargs = zip(objects, itertools.repeat(globalParameters))
 
+    parallel_kw = dict(n_jobs=threadCount, timeout=99999)
     if joblibParallelSupportsGenerator():
-        rv = Parallel(n_jobs=threadCount, timeout=99999, return_as=return_as)(
+        parallel_kw["return_as"] = return_as
+        rv = Parallel(**parallel_kw)(
             delayed(pcall)(function, a, params) for a, params in pargs
         )
     else:
-        rv = Parallel(n_jobs=threadCount, timeout=99999)(
+        rv = Parallel(**parallel_kw)(
             delayed(pcall)(function, a, params) for a, params in pargs
         )
 
diff --git a/projects/hipblaslt/tensilelite/Tensile/TensileLogic/ParseArguments.py b/projects/hipblaslt/tensilelite/Tensile/TensileLogic/ParseArguments.py
index 9ad26a4545..6619e35723 100644
--- a/projects/hipblaslt/tensilelite/Tensile/TensileLogic/ParseArguments.py
+++ b/projects/hipblaslt/tensilelite/Tensile/TensileLogic/ParseArguments.py
@@ -23,6 +23,7 @@
 ################################################################################
 
 from argparse import ArgumentParser
+import os
 from pathlib import Path
 
 from Tensile.Toolchain.Validators import ToolchainDefaults
@@ -56,7 +57,7 @@ def parseArguments():
         "-j",
         dest="Jobs",
         action="store",
-        default=48,
+        default=4 if os.name == "nt" else 48,
         help="number of worker processes to use during validation checks",
     )
     argParser.add_argument(
-- 
